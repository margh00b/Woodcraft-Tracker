{
  "name": "wckc-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:sync": "node scripts/db-sync.js",
    "db:diff": "supabase db schema declarative sync --no-apply -f",
    "web:dev": "npm --workspace=apps/web run dev",
    "insite:dev": "npm --workspace=apps/insite run start"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.29",
    "supabase": "^2.121.0"
  }
}
