{
  "name": "wckc-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:sync": "node scripts/db-sync.js",
    "db:diff": "supabase db schema declarative sync --no-apply -f",
    "web:dev": "npm --workspace=apps/web run dev",
    "insite:dev": "npm --workspace=apps/insite run start"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.33",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo": "~57.0.0",
    "react-native": "0.86.3"
  }
}
